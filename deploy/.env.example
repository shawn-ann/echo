# Echo 生产环境变量模板。
# 复制为 .env 后填写（CI 部署时由 GitHub Secrets 自动生成，见 .github/workflows/deploy.yml）。

# 数据库密码（随机生成，例如 openssl rand -hex 16）
DB_PASSWORD=change_me

# LLM 配置（阿里云百炼 compatible-mode）
LLM_BASE_URL=https://ws-txbjup55av7p8bl5.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=change_me
LLM_MODEL=glm-5.2

# 实验端点（master 部署默认开启）
COACH_MVP_ENABLED=true

# 服务器本地构建镜像源（可选）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
