# Echo 后端环境变量模板（本地开发）
# 复制为 backend/.env 后按需修改。所有值均为示例假值，请勿直接用于生产。

# 数据库
DATABASE_URL=postgresql+asyncpg://echo:change_me@localhost:5432/echo
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# LLM
# LLM_MODE 留空 = 真实调用；mock = 确定性 Mock（测试/演示，不产生费用）
LLM_MODE=mock
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-replace-with-your-key
LLM_MODEL=your-model-name

# 思考参数名：
#   chat_template_kwargs —— DeepSeek 等
#   enable_thinking        —— 百炼 Qwen / GLM
#   thinking               —— Anthropic 风格
LLM_THINKING_PARAM=chat_template_kwargs
# 仅思考模式的模型（如 glm-5.3）设为 true
LLM_THINKING_ALWAYS_ON=false

# 流式纠错实验端点，本地联调显式开启
STREAM_MVP_ENABLED=true

# 其他
CONTEXT_LIMIT=40
# casual（日常/职场口语）/ formal（正式书面）
CORRECTION_STYLE=casual

# MVP 固定种子账号
SEED_USERNAME=demo
SEED_PASSWORD=change_me_123

# 接入示例（任选其一，取消注释并替换假值）
#
# DeepSeek 官方 API
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-flash
# LLM_THINKING_PARAM=enable_thinking
# LLM_THINKING_ALWAYS_ON=true
#
# 阿里云百炼 compatible-mode
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-dashscope-key
# LLM_MODEL=glm-5.3
# LLM_THINKING_PARAM=enable_thinking
# LLM_THINKING_ALWAYS_ON=true
